---
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "somnaire",
    description = "somnaire is the package registry for Soma",
} = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#050608" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
            rel="stylesheet"
        />
        <title>{title}</title>
    </head>
    <body>
        <nav class="nav">
            <div class="container nav-inner">
                <a href="/" class="brand">
                    <span class="brand-name">somnaire</span>
                </a>
                <div class="nav-links">
                    <a href="/packages">packages</a>
                    <a href="/docs">docs</a>
                    <a href="https://github.com/SrGaabriel/soma">github</a>
                </div>
                <a href="/signin" class="nav-cta">sign in →</a>
            </div>
        </nav>
        <slot />
        <footer class="footer">
            <div class="container footer-inner">
                <div>© 2026 somnaire · Apache-2.0</div>
                <div>
                    <a href="/status">status</a> · <a href="/about">about</a> ·
                    <a href="https://github.com/SrGaabriel/leander">source</a>
                </div>
            </div>
        </footer>
    </body>
</html>
